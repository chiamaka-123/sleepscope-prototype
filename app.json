{
  "expo": {
    "name": "SleepScope",
    "slug": "sleepscope",
    "version": "1.0.0",
    "scheme": "sleepscope",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1c1c1e"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.anonymous.sleepscope",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "SleepScope requires microphone access to measure overnight ambient noise levels for sleep quality analysis."
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-audio"
    ]
  }
}
